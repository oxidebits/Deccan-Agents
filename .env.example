# Start in MOCK for a deterministic demo. Set LIVE to call OpenRouter.
RUN_MODE=MOCK
TEAMS_HMAC_SECRET=
ALLOW_UNSIGNED_WEBHOOKS=true
OPENROUTER_API_KEY=
OPENROUTER_TRIAGE_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_REVIEW_MODEL=deepseek/deepseek-r1
DEMO_PREMIUM_TOKEN=demo-premium-token

# Optional: enables a real draft PR. Keep empty to simulate the GitHub step.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/contextbridge-demo
GITHUB_BASE_BRANCH=main

