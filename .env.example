# Core LLM & Gateway
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# Real-Time Technical Documentation Search
EXA_API_KEY=your_exa_api_key

# Asynchronous Durable Workflows
TRIGGER_SECRET_KEY=tr_dev_xxxx

# GitHub Integration
GITHUB_TOKEN=ghp_xxxx
GITHUB_REPO=organization/repo-name
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Jira Cloud Integration
JIRA_SERVER=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=DECCAN

# Microsoft Teams / Azure Bot Service
MICROSOFT_APP_ID=xxxx-xxxx-xxxx-xxxx
MICROSOFT_APP_PASSWORD=your_azure_client_secret
TEAMS_WEBHOOK_URL=https://your-tenant.webhook.office.com/webhookb2/...

# Runtime Configuration
MOCK_MODE=true
PORT=8000
